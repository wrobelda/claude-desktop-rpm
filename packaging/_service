<?xml version="1.0"?>
<!--
  The 166 MB upstream .debs are NOT stored in git. OBS fetches them at
  source-service time with download_url, one per architecture; the spec
  verifies the SHA256 of the one it unpacks in %prep.
  scripts/bump-version.sh rewrites the URLs below (and the checksums +
  Version in the spec) when Anthropic publishes a new build.
-->
<services>
  <service name="download_url">
    <param name="url">https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_3.1623.4_amd64.deb</param>
    <param name="filename">claude-desktop_3.1623.4_amd64.deb</param>
  </service>
  <service name="download_url">
    <param name="url">https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_3.1623.4_arm64.deb</param>
    <param name="filename">claude-desktop_3.1623.4_arm64.deb</param>
  </service>
</services>
